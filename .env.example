# Environment variables template
# Copy this file to .env and fill in the actual values

# Application
DEBUG=False
LOG_LEVEL=INFO

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Audio Processing
AUDIO_SAMPLE_RATE=16000
AUDIO_MAX_DURATION=30.0

# ML Model
MODEL_PATH=

# Risk Thresholds
RISK_THRESHOLD_HIGH=0.8
RISK_THRESHOLD_MEDIUM=0.5

# Inference
INFERENCE_BATCH_SIZE=32

