# FastAPI base URL. The frontend defaults to http://localhost:8000.
VITE_API_BASE_URL=http://localhost:8000

# The final demo uses the live FastAPI endpoint by default. Set to true only for UI-only development.
VITE_USE_MOCK_API=false

# Optional override for the live detection endpoint.
VITE_DETECTION_ENDPOINT=/api/v1/predict
